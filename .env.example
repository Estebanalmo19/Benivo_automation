# Copy this file to .env and fill in real values. Never commit .env.
# Required settings (app fails clearly at startup if any are missing) are
# marked REQUIRED; everything else has a safe default.

#################################### Database ####################################
# REQUIRED. PostgreSQL connection for benivo.candidates / benivo.post_log and the
# jv_arrise_data_schema.jobvite_applications source table.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=benivo
DB_USER=benivo_app
DB_PASSWORD=change-me

#################################### Benivo API ###################################
# REQUIRED. Benivo OAuth2 client-credentials grant.
BENIVO_CLIENT_ID=change-me
BENIVO_CLIENT_SECRET=change-me
BENIVO_GRANT_TYPE=client_credentials

################################ Execution behavior ################################
# Default true. When true, no create-user or user-lookup call is ever made --
# post_candidates() only builds/logs sanitized preview payloads.
BENIVO_DRY_RUN=true

# Default 1. Hard cap on how many candidates a single "post"/"run" invocation
# will select and attempt to post. The selection SQL applies this as a LIMIT,
# never fetched-then-truncated in Python.
BENIVO_MAX_CANDIDATES=1

# Default false. When true, dry runs additionally authenticate and fetch live
# Benivo reference data (GET, read-only) so office resolution can be validated
# for real. Never enables the create-user or user-lookup calls -- those stay
# fully gated by BENIVO_DRY_RUN regardless of this flag.
BENIVO_ALLOW_REFERENCE_DATA_CALLS=false

# Optional, unset by default. Safety override for a controlled one-candidate
# UAT test: when set, candidate selection is pinned to EXACTLY this
# application_eid and every eligibility condition is re-validated individually
# (workflow_state, relocation, start_date, benivo_status, office resolution,
# policy, no terminal post_log result). If any check fails, nothing is
# selected and nothing is posted -- it never falls back to another candidate.
# Leave unset for normal/scheduled operation.
BENIVO_UAT_APPLICATION_EID=

# Optional legacy fallback (no BENIVO_ prefix): default LIMIT used only by the
# low-level candidate_repository.get_ready_candidates() when no explicit
# limit is passed. BENIVO_MAX_CANDIDATES above is what the actual pipeline uses.
MAX_CANDIDATES=1

#################################### Reporting ####################################
# Optional. Directory the operational Excel report is written to (created if
# missing). Relative paths resolve against the current working directory.
# Defaults to the repository root if unset.
REPORT_FOLDER=reports

##################################### Logging #####################################
# Optional. Standard Python logging level name. Default INFO.
LOG_LEVEL=INFO
