# Copy this file to .env and fill in real values. Never commit .env.
# Required settings (app fails clearly at startup if any are missing) are
# marked REQUIRED; everything else has a safe default.

#################################### Database ####################################
# REQUIRED. PostgreSQL connection for benivo.candidates / benivo.post_log and the
# jv_arrise_data_schema.jobvite_applications source table.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=benivo
DB_USER=benivo_app
DB_PASSWORD=change-me

#################################### Benivo API ###################################
# REQUIRED. Benivo OAuth2 client-credentials grant.
BENIVO_CLIENT_ID=change-me
BENIVO_CLIENT_SECRET=change-me
BENIVO_GRANT_TYPE=client_credentials

############################ Benivo API endpoints (UAT vs Production) ############
# REQUIRED. Every Benivo HTTP endpoint the app calls -- see app/clients/
# benivo_client.py, which never hardcodes a URL and reads these exclusively.
# Switching the whole app from UAT to Production is meant to be ONLY a
# matter of changing these five values (plus BENIVO_CLIENT_ID/SECRET above)
# in .env; no Python source code should need to change.
#
# The values below are the current confirmed UAT endpoints. Production
# endpoint values are NOT YET CONFIRMED as of 2026-08-21 -- do not guess
# them. Get the confirmed Production URLs from Benivo (their GitBook, once
# available, or a direct confirmation email the same way UAT's were
# confirmed) before setting these in a production .env.
BENIVO_TOKEN_URL=https://externalapi.uat.benivo.com/idm/v1/Token/OAuth2
BENIVO_REFDATA_URL=https://hubapi.uat.benivo.com/v3/api/user/refdata
BENIVO_CREATE_USER_URL=https://hubapi.uat.benivo.com/v3/api/user/create
BENIVO_USER_LOOKUP_URL=https://hubapi.uat.benivo.com/v3/api/user/userassignment
BENIVO_CASE_URL=https://externalapi.uat.benivo.com/clients/v1/Case

################################ Execution behavior ################################
# Default true. When true, no create-user or user-lookup call is ever made --
# post_candidates() only builds/logs sanitized preview payloads.
BENIVO_DRY_RUN=true

# Default 1. Hard cap on how many candidates a single "post"/"run" invocation
# will select and attempt to post. The selection SQL applies this as a LIMIT,
# never fetched-then-truncated in Python.
BENIVO_MAX_CANDIDATES=1

# Default false. When true, dry runs additionally authenticate and fetch live
# Benivo reference data (GET, read-only) so office resolution can be validated
# for real. Never enables the create-user or user-lookup calls -- those stay
# fully gated by BENIVO_DRY_RUN regardless of this flag.
BENIVO_ALLOW_REFERENCE_DATA_CALLS=false

# Optional, unset by default. Safety override for a controlled one-candidate
# UAT test: when set, candidate selection is pinned to EXACTLY this
# application_eid and every eligibility condition is re-validated individually
# (workflow_state, relocation, start_date, benivo_status, office resolution,
# policy, no terminal post_log result). If any check fails, nothing is
# selected and nothing is posted -- it never falls back to another candidate.
# Leave unset for normal/scheduled operation.
BENIVO_UAT_APPLICATION_EID=

# Optional legacy fallback (no BENIVO_ prefix): default LIMIT used only by the
# low-level candidate_repository.get_ready_candidates() when no explicit
# limit is passed. BENIVO_MAX_CANDIDATES above is what the actual pipeline uses.
MAX_CANDIDATES=1

# Optional, unset by default. Production go-live cutover, ISO 8601 (e.g.
# 2026-09-01T00:00:00Z). While unset, get_ready_candidates() applies no
# go-live filtering at all (today's exact pre-go-live behavior). Once set,
# only candidates benivo.scope_history records as first seen in the Benivo
# posting scope ON OR AFTER this timestamp are eligible for automatic
# posting -- the existing READY_TO_POST backlog stays excluded from
# auto-posting (but still visibly READY_TO_POST everywhere) forever.
#
# REQUIRED SEQUENCING -- do not set this until ALL of the following have
# already happened, or the entire pre-existing backlog will look "new":
#   1. migrations/0008_add_scope_history_table.sql has been applied.
#   2. scripts/backfill_scope_history.py --apply has been run.
#   3. The scope_history-aware code has been deployed.
# See docs/PHASE1_ARCHITECTURE.md's Go-Live section for the full procedure.
BENIVO_GO_LIVE_AT=

#################################### Reporting ####################################
# Optional. Directory the operational Excel report is written to (created if
# missing). Relative paths resolve against the current working directory.
# Defaults to the repository root if unset.
REPORT_FOLDER=reports

# Default false. When true, every newly generated operational report is
# automatically delivered (one HTTP POST, Base64-encoded xlsx + summary
# metadata) to the Power Automate trigger at BENIVO_REPORT_WEBHOOK_URL --
# see app/services/report_delivery_service.py. Delivery is best-effort and
# fully isolated from the Benivo business transaction: a delivery failure
# never affects create-user, Case PATCH, candidate status, or post_log.
BENIVO_REPORT_DELIVERY_ENABLED=false

# Required only when BENIVO_REPORT_DELIVERY_ENABLED=true. The signed Power
# Automate HTTP-trigger URL. NEVER put the real value in this example file
# or in version control -- set it only in your local, untracked .env.
BENIVO_REPORT_WEBHOOK_URL=

##################################### Logging #####################################
# Optional. Standard Python logging level name. Default INFO.
LOG_LEVEL=INFO
